train_input_path: "examples/data/ali_ccp/ali_ccp_train_medium.csv"
eval_input_path: "examples/data/ali_ccp/ali_ccp_test_medium.csv"
model_dir: "examples/ckpt/deepfm_ali_ccp_medium_ps"

train_config {
  log_step_count_steps: 50

  # 优化器配置 - 适配分布式训练
  optimizer_config: {
    adam_optimizer: {
      learning_rate: {
        exponential_decay_learning_rate {
          initial_learning_rate: 0.001
          decay_steps: 1000
          decay_factor: 0.9
          min_learning_rate: 0.00001
        }
      }
    }
    use_moving_average: false
  }

  # 分布式训练配置
  # sync_replicas: true 表示同步训练，所有worker同步更新
  # sync_replicas: false 表示异步训练，worker独立更新
  # 注意: 使用TF_CONFIG时，使用默认的NoStrategy即可
  sync_replicas: true

  # PS-Worker 分布式策略
  # 注释掉PSStrategy，使用默认NoStrategy with TF_CONFIG
  # train_distribute: PSStrategy

  # 保存检查点
  save_checkpoints_steps: 500
  keep_checkpoint_max: 5

  # 训练步数
  num_steps: 5000
}

eval_config {
  metrics_set: {
    auc {}
  }
  metrics_set: {
    accuracy {}
  }
  metrics_set: {
    gauc {
      uid_field: 'user_id'
    }
  }
}

data_config {
  # 输入字段定义
  input_fields {
    input_name:'label'
    input_type: INT32
  }
  input_fields {
    input_name:'user_id'
    input_type: STRING
  }
  input_fields {
    input_name: 'item_id'
    input_type: STRING
  }
  input_fields {
    input_name: 'f_301'
    input_type: STRING
  }
  input_fields {
    input_name: 'f_205'
    input_type: STRING
  }
  input_fields {
    input_name: 'f_206'
    input_type: STRING
  }
  input_fields {
    input_name: 'f_207'
    input_type: STRING
  }
  input_fields {
    input_name: 'f_210'
    input_type: STRING
  }

  label_fields: 'label'

  # 批大小 - 针对CPU优化
  # 在分布式训练中，这是每个worker的batch size
  # 实际全局batch size = batch_size * num_workers
  batch_size: 512

  num_epochs: 10

  # 预取大小 - CPU优化
  prefetch_size: 64

  input_type: CSVInput
  separator: ','
  with_header: true

  # 并行调用数 - CPU优化
  # 增加并行度以充分利用CPU
  num_parallel_calls: 8
}

feature_config: {
  features: {
    input_names: 'user_id'
    feature_type: IdFeature
    embedding_dim: 16
    hash_bucket_size: 50000
  }
  features: {
    input_names: 'item_id'
    feature_type: IdFeature
    embedding_dim: 16
    hash_bucket_size: 100
  }
  features: {
    input_names: 'f_301'
    feature_type: IdFeature
    embedding_dim: 16
    hash_bucket_size: 5000
  }
  features: {
    input_names: 'f_205'
    feature_type: IdFeature
    embedding_dim: 16
    hash_bucket_size: 5000
  }
  features: {
    input_names: 'f_206'
    feature_type: IdFeature
    embedding_dim: 16
    hash_bucket_size: 5000
  }
  features: {
    input_names: 'f_207'
    feature_type: IdFeature
    embedding_dim: 16
    hash_bucket_size: 5000
  }
  features: {
    input_names: 'f_210'
    feature_type: IdFeature
    embedding_dim: 16
    hash_bucket_size: 5000
  }
}

model_config:{
  model_class: "DeepFM"

  feature_groups: {
    group_name: 'wide'
    feature_names: 'user_id'
    feature_names: 'item_id'
    feature_names: 'f_301'
    feature_names: 'f_205'
    feature_names: 'f_206'
    feature_names: 'f_207'
    feature_names: 'f_210'
    wide_deep: WIDE
  }

  feature_groups: {
    group_name: 'deep'
    feature_names: 'user_id'
    feature_names: 'item_id'
    feature_names: 'f_301'
    feature_names: 'f_205'
    feature_names: 'f_206'
    feature_names: 'f_207'
    feature_names: 'f_210'
    wide_deep: DEEP
  }

  deepfm {
    dnn {
      hidden_units: [128, 64, 32]
    }
    final_dnn {
      hidden_units: [64, 32]
    }
    l2_regularization: 1e-5
  }

  embedding_regularization: 1e-5
}
